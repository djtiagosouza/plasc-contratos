}
aside nav::-webkit-scrollbar-track {
  border-radius: 10px;
}
aside nav::-webkit-scrollbar-thumb {
  border-radius: 10px;
  background: #111111;
}
aside ul.nav {
  margin-bottom: 25px;
}
aside ul.nav li a {
  display: block;
  position: relative;
  padding-left: 50px;
  font-size: 1.5rem;
  font-weight: 400;
  text-transform: uppercase;
  text-decoration: none;
