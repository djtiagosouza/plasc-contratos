}
aside ul.nav li a svg {
  position: absolute;
  top: 50%;
  left: 15px;
  width: 20px;
  height: 20px;
  fill: currentColor;
  transform: translate(0, -50%);
  transform: translate3d(0, -50%, 0);
}
aside ul.nav li a .lnr-star {
  margin-top: -1px;
}
aside ul.nav li a span {
  display: block;
  position: absolute;
  top: 50%;
  left: 15px;
