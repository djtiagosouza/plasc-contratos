/* -------------------------------------------------------------------------- */
/* 1. GRID LAYOUT E BASE (Origem: style_grid.css)                             */
/* -------------------------------------------------------------------------- */

html, body {
  margin: 0;
  height: 100%;
}

.layout {
  display: grid;
  

  grid-template-areas:
    "aside header header"
    "aside main   main"
    "aside footer footer";

  grid-template-columns: 250px 1fr 1fr;
  grid-template-rows: 80px 1fr 50px;

  height: 100vh;
}

/* Base */
.grid {
  
  padding: 1rem;
}

/* Áreas */
.grid-header {
  grid-area: header;
  background: #ec3608;
  text-align: center;
  
}

.grid-main {
  grid-area: main;
  overflow-y: auto; /* 🔥 Só o main rola */
 
}

.grid-aside {
  grid-area: aside;
  overflow: hidden; /* impede rolagem */
  background: #18aff5;
}

.grid-footer {
  grid-area: footer;
  background: #ec3608;
}


